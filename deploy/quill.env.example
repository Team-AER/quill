# /etc/quill/quill.env (0640 root:quill). Created from this file on first install;
# QUILL_SECRET_KEY is generated then and never overwritten by later releases.
QUILL_DATA_DIR=/var/lib/quill
# All model traffic goes through llm-proxy; never point at a backend IP/port.
QUILL_GATEWAY_URL=http://llm-proxy.lan/v1
QUILL_STT_MODEL=aer-stt-v1
QUILL_VISION_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
QUILL_TEXT_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
QUILL_DIARIZER_CMD=/opt/quill/diarizer-venv/bin/quill-diarize
# Passed through to the diarizer subprocess (weights downloaded by install-release.sh).
QUILL_DIARIZER_MODEL=/var/lib/quill/models/nemotron-3-diarization
QUILL_DIARIZER_THREADS=4
HF_HUB_OFFLINE=1
# 10 GiB
QUILL_MAX_UPLOAD_BYTES=10737418240
QUILL_VIDEO_RETENTION_DAYS=14
QUILL_STT_CONCURRENCY=3
QUILL_VISION_CONCURRENCY=2
QUILL_FRAMES_PER_HOUR=40
QUILL_MAX_FRAMES=200
QUILL_SECRET_KEY=
QUILL_PUBLIC_URL=https://quill.example.com
